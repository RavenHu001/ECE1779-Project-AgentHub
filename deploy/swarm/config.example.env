# Non-secret, trusted Bash configuration. Copy to an ignored .env.cloud file.
# Replace every REPLACE_* value; placeholders intentionally fail preflight.
STACK=agenthub
AGENTHUB_IMAGE=ghcr.io/REPLACE_OWNER/REPLACE_REPOSITORY/backend@sha256:REPLACE_APP_DIGEST
POSTGRES_IMAGE=docker.io/library/postgres@sha256:REPLACE_POSTGRES_17_DIGEST
POSTGRES_DB=agenthub
POSTGRES_USER=agenthub
BOOTSTRAP_USERNAME=developer
DB_PASSWORD_SECRET=agenthub-db-v1
BOOTSTRAP_PASSWORD_SECRET=agenthub-bootstrap-v1
API_REPLICAS=2
WORKER_REPLICAS=2
API_PUBLISHED_PORT=18000

# Run on the native Linux manager; this SSH alias must reach the other Swarm node.
WORKER_SSH=agenthub-worker
IMAGE_MODE=registry
STORAGE_MODE=volume
POSTGRES_VOLUME_MOUNT=/mnt/agenthub-volume
POSTGRES_VOLUME_UUID=REPLACE_FILESYSTEM_UUID
POSTGRES_DATA_PATH=/mnt/agenthub-volume/postgres
DEPLOY_TIMEOUT=300
# All operators/checkouts must share this lock. Do not put it inside the repo.
DEPLOY_LOCK_PATH=/var/lock/agenthub-deploy.lock

# One-node native Linux rehearsal only: IMAGE_MODE=local, STORAGE_MODE=directory,
# a fresh absolute POSTGRES_DATA_PATH and explicit locally built versioned tags.
# Do not put passwords, registry tokens or SSH private keys in this file.
