# Run: python scripts/init_env.py
# 运行此命令生成实际配置。
# Real .env files are ignored by Git. Never commit credentials.
# 实际 .env 被 Git 忽略；不要提交凭据。
# Use distinct project names and ports for independent environments on one host.
# 同一主机上的独立环境应使用不同项目名和端口。
COMPOSE_PROJECT_NAME=agenthub-dev
API_BIND_HOST=127.0.0.1
API_PORT=8000
POSTGRES_DB=agenthub
POSTGRES_USER=agenthub
POSTGRES_PASSWORD=GENERATE_WITH_INIT_ENV
BOOTSTRAP_USERNAME=developer
BOOTSTRAP_PASSWORD=GENERATE_WITH_INIT_ENV
WORKER_POLL_SECONDS=1
WORKER_LEASE_SECONDS=60
WORKER_MAX_ATTEMPTS=3
# English system output; user-submitted Unicode text is stored as provided.
# 系统输出使用英文；用户提交的 Unicode 文本保持原样。
FIXED_REPLY=Message received.
